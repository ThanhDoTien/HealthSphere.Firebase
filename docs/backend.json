
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user's profile, health statistics, and personal goals. This information is used to personalize the user's experience and provide tailored AI suggestions.",
      "properties": {
        "name": {
          "type": "string",
          "description": "User's full name."
        },
        "email": {
          "type": "string",
          "description": "User's email address.",
          "format": "email"
        },
        "age": {
          "type": "number",
          "description": "User's age in years."
        },
        "height": {
          "type": "number",
          "description": "User's height in centimeters."
        },
        "weight": {
          "type": "number",
          "description": "User's weight in kilograms."
        },
        "gender": {
          "type": "string",
          "description": "User's self-declared gender."
        },
        "goal": {
          "type": "string",
          "description": "User's primary health goal (e.g., 'Lose weight', 'Gain muscle')."
        },
        "activityLevel": {
          "type": "string",
          "description": "User's daily activity level for Harris-Benedict calculation.",
          "enum": ["sedentary", "light", "moderate", "active", "extra"]
        }
      },
      "required": ["name", "email", "age", "height", "weight", "gender", "goal", "activityLevel"]
    },
    "WeightLog": {
      "title": "WeightLog",
      "type": "object",
      "description": "A single weight measurement for a user on a specific date.",
      "properties": {
        "userId": {
          "type": "string",
          "description": "ID of the user this weight log belongs to."
        },
        "date": {
          "type": "string",
          "description": "The date of the weight measurement.",
          "format": "date"
        },
        "weight": {
          "type": "number",
          "description": "Weight in kilograms."
        }
      },
      "required": ["userId", "date", "weight"]
    },
    "MealLog": {
      "title": "MealLog",
      "type": "object",
      "description": "A single meal entry, which can represent a single food item or a full meal composed of multiple items. This can be logged manually by the user or automatically via AI image recognition.",
      "properties": {
        "userId": {
          "type": "string",
          "description": "ID of the user this meal log belongs to."
        },
        "name": {
          "type": "string",
          "description": "Name of the meal or food item. For AI-generated logs, this may be a comma-separated list of identified foods, prefixed with 'AI: '."
        },
        "calories": {
          "type": "number",
          "description": "Calorie count for the meal."
        },
        "mealType": {
          "type": "string",
          "description": "The type of meal.",
          "enum": ["breakfast", "lunch", "dinner", "snack"]
        },
        "date": {
          "type": "string",
          "description": "The date the meal was consumed.",
          "format": "date"
        }
      },
      "required": ["userId", "name", "calories", "mealType", "date"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "type": "object",
      "description": "A physical activity performed by the user.",
      "properties": {
        "userId": {
          "type": "string",
          "description": "ID of the user this activity log belongs to."
        },
        "name": {
          "type": "string",
          "description": "Name of the activity."
        },
        "duration": {
          "type": "number",
          "description": "Duration of the activity in minutes."
        },
        "caloriesBurned": {
          "type": "number",
          "description": "Estimated calories burned during the activity."
        },
        "date": {
          "type": "string",
          "description": "The date the activity was performed.",
          "format": "date"
        }
      },
      "required": ["userId", "name", "duration", "caloriesBurned", "date"]
    },
    "SleepLog": {
      "title": "SleepLog",
      "type": "object",
      "description": "A single sleep log for a user on a specific date.",
      "properties": {
        "userId": {
          "type": "string",
          "description": "ID of the user this sleep log belongs to."
        },
        "date": {
          "type": "string",
          "description": "The date of the sleep entry.",
          "format": "date"
        },
        "duration": {
          "type": "number",
          "description": "Duration of sleep in hours."
        }
      },
      "required": ["userId", "date", "duration"]
    },
    "TodaySnapshot": {
      "title": "TodaySnapshot",
      "type": "object",
      "description": "A snapshot of the user's health data at the time of an AI suggestion request.",
      "properties": {
        "userProfile": {
          "type": "object",
          "properties": {
            "goal": { "type": "string" },
            "weight": { "type": "number" },
            "height": { "type": "number" },
            "age": { "type": "number" },
            "gender": { "type": "string" },
            "activityLevel": { "type": "string" }
          }
        },
        "dailySummary": {
          "type": "object",
          "properties": {
            "caloriesConsumed": { "type": "number" },
            "caloriesBurned": { "type": "number" },
            "sleepHours": { "type": "number" }
          }
        },
        "recentActivities": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "TodaySuggestion": {
      "title": "TodaySuggestion",
      "type": "object",
      "description": "AI-generated health suggestions for a specific day.",
      "properties": {
        "mealSuggestions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "recipe": { "type": "string" },
              "calories": { "type": "number" },
              "imageUrl": { "type": "string" }
            },
            "required": ["name", "recipe", "calories", "imageUrl"]
          }
        },
        "workoutSuggestion": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "imageUrl": { "type": "string" }
            },
            "required": ["name", "description", "imageUrl"]
          }
        },
        "generalTip": { "type": "string" }
      },
      "required": ["mealSuggestions", "workoutSuggestion", "generalTip"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "google.com"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": {
            "$ref": "#/backend/entities/UserProfile"
          },
          "description": "Stores individual user profiles. Access is strictly private to the owning user."
        }
      },
      {
        "path": "/users/{userId}/weights/{weightId}",
        "definition": {
          "entityName": "WeightLog",
          "schema": {
            "$ref": "#/backend/entities/WeightLog"
          },
          "description": "Stores a user's daily weight entries. Private to the user."
        }
      },
      {
        "path": "/users/{userId}/meals/{mealId}",
        "definition": {
          "entityName": "MealLog",
          "schema": {
            "$ref": "#/backend/entities/MealLog"
          },
          "description": "Stores a user's meal entries. Private to the user."
        }
      },
      {
        "path": "/users/{userId}/activities/{activityId}",
        "definition": {
          "entityName": "ActivityLog",
          "schema": {
            "$ref": "#/backend/entities/ActivityLog"
          },
          "description": "Stores a user's activity entries. Private to the user."
        }
      },
      {
        "path": "/users/{userId}/sleep/{sleepId}",
        "definition": {
          "entityName": "SleepLog",
          "schema": {
            "$ref": "#/backend/entities/SleepLog"
          },
          "description": "Stores a user's daily sleep entries. Private to the user."
        }
      },
      {
        "path": "/users/{userId}/todaysnapshots/{snapshotId}",
        "definition": {
          "entityName": "TodaySnapshot",
          "schema": {
            "$ref": "#/backend/entities/TodaySnapshot"
          },
          "description": "Stores a snapshot of user data for AI suggestion generation. Private to the user."
        }
      },
      {
        "path": "/users/{userId}/todaysuggestions/{suggestionId}",
        "definition": {
          "entityName": "TodaySuggestion",
          "schema": {
            "$ref": "#/backend/entities/TodaySuggestion"
          },
          "description": "Stores daily AI-generated health suggestions. Private to the user."
        }
      }
    ]
  }
}
