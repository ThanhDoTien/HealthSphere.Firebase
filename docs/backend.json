{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Lưu trữ thông tin hồ sơ người dùng.",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID định danh duy nhất của người dùng."
        },
        "username": {
          "type": "string",
          "description": "Tên người dùng được chọn."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Địa chỉ email của người dùng."
        },
        "dateOfBirth": {
          "type": "string",
          "format": "date",
          "description": "Ngày sinh của người dùng."
        },
        "gender": {
          "type": "string",
          "description": "Giới tính của người dùng."
        },
        "heightCm": {
          "type": "number",
          "description": "Chiều cao của người dùng tính bằng centimet."
        }
      },
      "required": [
        "id",
        "username",
        "email"
      ]
    },
    "MealLog": {
      "title": "MealLog",
      "type": "object",
      "description": "Nhật ký về một bữa ăn do người dùng tiêu thụ.",
      "properties": {
        "userId": {
          "type": "string",
          "description": "ID của người dùng đã ghi lại bữa ăn."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Thời điểm bữa ăn được ghi lại."
        },
        "description": {
          "type": "string",
          "description": "Mô tả về bữa ăn."
        },
        "calorieCount": {
          "type": "number",
          "description": "Lượng calo ước tính trong bữa ăn."
        }
      },
      "required": [
        "userId",
        "timestamp",
        "calorieCount"
      ]
    },
    "WeightLog": {
      "title": "WeightLog",
      "type": "object",
      "description": "Hồ sơ về cân nặng của người dùng tại một thời điểm cụ thể.",
      "properties": {
        "userId": {
          "type": "string",
          "description": "ID của người dùng."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Thời điểm cân nặng được ghi lại."
        },
        "weightKg": {
          "type": "number",
          "description": "Cân nặng tính bằng kilogam."
        }
      },
      "required": [
        "userId",
        "timestamp",
        "weightKg"
      ]
    },
    "Recipe": {
      "title": "Recipe",
      "type": "object",
      "description": "Một công thức nấu ăn với thành phần và hướng dẫn.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Tên của công thức."
        },
        "ingredients": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Danh sách các thành phần."
        },
        "instructions": {
          "type": "string",
          "description": "Hướng dẫn nấu ăn."
        },
        "calorieCount": {
          "type": "number",
          "description": "Lượng calo ước tính mỗi khẩu phần."
        }
      },
      "required": [
        "name",
        "ingredients",
        "instructions"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "Lưu trữ thông tin hồ sơ người dùng."
        }
      },
      {
        "path": "/users/{userId}/mealLogs/{mealLogId}",
        "definition": {
          "entityName": "MealLog",
          "schema": {
            "$ref": "#/backend/entities/MealLog"
          },
          "description": "Một bộ sưu tập các nhật ký bữa ăn cho một người dùng cụ thể."
        }
      },
      {
        "path": "/users/{userId}/weightLogs/{weightLogId}",
        "definition": {
          "entityName": "WeightLog",
          "schema": {
            "$ref": "#/backend/entities/WeightLog"
          },
          "description": "Một bộ sưu tập các nhật ký cân nặng cho một người dùng cụ thể."
        }
      },
      {
        "path": "/recipes/{recipeId}",
        "definition": {
          "entityName": "Recipe",
          "schema": {
            "$ref": "#/backend/entities/Recipe"
          },
          "description": "Một bộ sưu tập các công thức nấu ăn có sẵn trên toàn cầu."
        }
      }
    ]
  }
}