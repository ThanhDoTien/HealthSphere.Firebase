rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- User Profiles & Subcollections ---
    // This single rule covers:
    // 1. The user's own profile document (/users/{userId})
    // 2. All documents in all subcollections (/users/{userId}/meal_logs/{logId}, etc.)
    //
    // RULE: You can only read or write your own data.
    // This is checked by comparing your login UID (request.auth.uid)
    // with the UID in the document path (userId).
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth.uid == userId;
    }

    // --- Forum Posts ---
    // Path: /forum_posts/{postId}
    match /forum_posts/{postId} {
      // ANYONE can read forum posts.
      allow read: if true;
      
      // You can ONLY create a post with your own userId.
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      // You can ONLY update or delete your own posts.
      // This is checked by comparing your login UID with the userId stored in the post.
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // --- Recipes ---
    // Path: /recipes/{recipeId}
    match /recipes/{recipeId} {
      // Recipes are public for anyone to read.
      allow get, list: if true;
      // No one can write recipes from the client app.
      allow write: if false;
    }
  }
}
