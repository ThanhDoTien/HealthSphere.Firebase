
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/{allPaths=**} {
      // Cho phép người dùng đọc và ghi vào thư mục riêng của họ
      // users/7Sdm8GrNP7gNYV91lJoohx8kjGA2/...
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
