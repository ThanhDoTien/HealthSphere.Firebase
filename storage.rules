rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Quy tắc cho thư mục riêng tư của từng User
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Quy tắc cho thư mục CHUNG 'images' và 'ImagePlacehoder'
    // Cho phép mọi người ĐỌC (public) và người dùng đăng nhập có quyền GHI vào images
    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /ImagePlacehoder/{allPaths=**} {
      allow read: if true;
      allow write: if false; // Chỉ admin được ghi (thông qua console)
    }
  }
}