rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Quy tắc cho thư mục riêng tư của từng User
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Quy tắc cho thư mục CHUNG (shared/ai)
    // Cho phép tất cả người dùng đã đăng nhập ĐỌC và GHI
    // Điều này giúp cơ chế cache hoạt động cho toàn bộ cộng đồng
    match /shared/ai/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}